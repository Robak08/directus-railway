{% layout "base" %} {% block content %}

<h1>Vaihda Krakovan Opas -salasana</h1>

<p style="padding-bottom: 30px">
  Saimme pyynnön vaihtaa Krakovan Opas -tilisi salasana. Jos et pyysi
  vaihtoa, voit jättää tämän viestin huomiotta. Muussa tapauksessa napsauta
  alla olevaa painiketta ja aseta uusi salasana.
</p>

<a
  class="button"
  rel="noopener noreferrer"
  target="_blank"
  href="{{ url }}"
  style="
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    display: inline-block;
    padding: 11px 24px;
    border-radius: 8px;
    background: {{ projectColor }};
    border: 1px solid {{ projectColor }};
  "
>
  <!--[if mso]>
    <i style="letter-spacing: 25px; mso-font-width: -100%; mso-text-raise: 30pt"
      >&nbsp;</i
    >
  <![endif]-->
  <span style="mso-text-raise: 15pt">Vaihda salasana</span>
  <!--[if mso]>
    <i style="letter-spacing: 25px; mso-font-width: -100%">&nbsp;</i>
  <![endif]-->
</a>

<p style="padding-top: 24px; font-size: 14px; color: #737373">
  Huom: tämä linkki vanhenee 24 tunnin kuluttua.
</p>

{% endblock %}
