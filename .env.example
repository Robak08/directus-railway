KEY=
SECRET=

DB_CLIENT="pg"
DB_HOST="database"
DB_PORT="5432"
DB_DATABASE="directus"
DB_USER="directus"
DB_PASSWORD="directus"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="d1r3ctu5"

STORAGE_LOCATIONS="s3"
STORAGE_S3_DRIVER="s3"
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT="s3.amazonaws.com"

# Backup cron service (scripts/backup — see scripts/backup/README.md)
# DB_CONNECTION_STRING=<Railway Postgres URL>
# BACKUP_S3_BUCKET=krakovanopas-bckp
# BACKUP_RETENTION_DAYS=30
# BACKUP_FILES_ENABLED=true

CORS_ENABLED=true
# Directus 12 enforces CORS_ORIGIN for WebSocket connections — use explicit origins, not *
CORS_ORIGIN="https://krakovanopas.fi,https://cms.krakovanopas.fi,http://localhost:5173"
CORS_ALLOWED_HEADERS="*"
CORS_EXPOSED_HEADERS="*"
CORS_METHODS="*"

IP_TRUST_PROXY=true

# Push notifications
# Railway / ops: keep VAPID_* (config.cjs maps them to PUSH_* for Directus).
# Extension also accepts PUSH_* directly.
CONFIG_PATH=config.cjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional explicit subject (recommended in production; PUBLIC_URL may be http://0.0.0.0:$PORT)
# PUSH_VAPID_SUBJECT=https://cms.krakovanopas.fi
# Or use the extension's native names directly:
# PUSH_PUBLIC_VAPID_KEY=
# PUSH_PRIVATE_VAPID_KEY=

# Email (Directus — use ses in production)
EMAIL_TRANSPORT=ses
EMAIL_FROM=noreply@example.com
EMAIL_SES_REGION=eu-north-1
EMAIL_SES_CREDENTIALS__ACCESS_KEY_ID=
EMAIL_SES_CREDENTIALS__SECRET_ACCESS_KEY=

# Stripe checkout extension
# Server-side Stripe API key (sk_…) used to create Checkout sessions and billing-portal sessions.
STRIPE_SECRET_KEY=
# Stripe Dashboard webhook signing secret (whsec_…). Directus-only.
# Verifies POST /krk-guide/guide-webhook came from Stripe. Do not reuse as CHECKOUT_SERVICE_SECRET.
STRIPE_VERIFICATION_SECRET=
# Fallback Stripe Price id when CHECKOUT_ALLOW_LEGACY_ENV_PRICE=true (CMS offers are preferred).
STRIPE_GUIDEBOOK_PRICE_ID=price_1T0pOmLS9vjYkpnxZA0xGlgs
# Directus role assigned to provisioned guidebook customers.
CUSTOMER_ROLE_ID=08786164-2773-4adb-acd3-d9aec3aecfcc
# Production app URLs
# Invite landing page emailed after purchase when KRK_GUIDE_PROVISION_USERS=true.
APP_INVITE_URL=https://app.krakovanopas.fi/luo-salasana
# Allowed origin for checkout success/cancel redirects and billing-portal return.
APP_ORIGIN=https://app.krakovanopas.fi
# Directus allow-list for user-invite redirect URLs (must include APP_INVITE_URL).
USER_INVITE_URL_ALLOW_LIST=https://app.krakovanopas.fi/luo-salasana
# Local dev (krk-app Vite on 3000 — avoid 5173/5174; blocked by Windows Hyper-V)
# APP_INVITE_URL=http://localhost:3000/luo-salasana
# APP_ORIGIN=http://localhost:3000
# USER_INVITE_URL_ALLOW_LIST=http://localhost:3000/luo-salasana
# When true, the Stripe webhook also creates/upgrades a Directus user and sends an invite.
KRK_GUIDE_PROVISION_USERS=false
# Shared secret with krk-app (Vercel). Sent as x-checkout-service-key so guest checkout
# can call POST /krk-stripe/checkout-session and GET status without a user login.
# Generate yourself (e.g. openssl rand -hex 32). Must match krk-app CHECKOUT_SERVICE_SECRET.
CHECKOUT_SERVICE_SECRET=
# When true, checkout may fall back to STRIPE_GUIDEBOOK_PRICE_ID if no CMS offer is found.
CHECKOUT_ALLOW_LEGACY_ENV_PRICE=false
# Directus allow-list for password-reset email links (app route /vaihda-salasana).
PASSWORD_RESET_URL_ALLOW_LIST=https://app.krakovanopas.fi/vaihda-salasana
# Where Stripe Billing Portal returns after the customer finishes managing a subscription.
STRIPE_BILLING_PORTAL_RETURN_URL=https://app.krakovanopas.fi/oma-tili/profiili