KEY=
SECRET=

DB_CLIENT="pg"
DB_HOST="database"
DB_PORT="5432"
DB_DATABASE="directus"
DB_USER="directus"
DB_PASSWORD="directus"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="d1r3ctu5"

STORAGE_LOCATIONS="s3"
STORAGE_S3_DRIVER="s3"
STORAGE_S3_KEY=
STORAGE_S3_SECRET=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT="s3.amazonaws.com"

# Backup cron service (scripts/backup — see scripts/backup/README.md)
# DB_CONNECTION_STRING=<Railway Postgres URL>
# BACKUP_S3_BUCKET=krakovanopas-bckp
# BACKUP_RETENTION_DAYS=30
# BACKUP_FILES_ENABLED=true

CORS_ENABLED=true
# Directus 12 enforces CORS_ORIGIN for WebSocket connections — use explicit origins, not *
CORS_ORIGIN="https://krakovanopas.fi,https://cms.krakovanopas.fi,http://localhost:5173"
CORS_ALLOWED_HEADERS="*"
CORS_EXPOSED_HEADERS="*"
CORS_METHODS="*"

IP_TRUST_PROXY=true

# Push notifications
# Railway / ops: keep VAPID_* (config.cjs maps them to PUSH_* for Directus).
# Extension also accepts PUSH_* directly.
CONFIG_PATH=config.cjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional explicit subject (recommended in production; PUBLIC_URL may be http://0.0.0.0:$PORT)
# PUSH_VAPID_SUBJECT=https://cms.krakovanopas.fi
# Or use the extension's native names directly:
# PUSH_PUBLIC_VAPID_KEY=
# PUSH_PRIVATE_VAPID_KEY=

# Email (Directus — use ses in production)
EMAIL_TRANSPORT=ses
EMAIL_FROM=noreply@example.com
EMAIL_SES_REGION=eu-north-1
EMAIL_SES_CREDENTIALS__ACCESS_KEY_ID=
EMAIL_SES_CREDENTIALS__SECRET_ACCESS_KEY=

# Stripe checkout extension
STRIPE_SECRET_KEY=
# Stripe Dashboard webhook signing secret for POST /krk-guide/guide-webhook
STRIPE_VERIFICATION_SECRET=
STRIPE_GUIDEBOOK_PRICE_ID=price_1T0pOmLS9vjYkpnxZA0xGlgs
CUSTOMER_ROLE_ID=08786164-2773-4adb-acd3-d9aec3aecfcc
# Production app URLs
APP_INVITE_URL=https://app.krakovanopas.fi/luo-salasana
APP_ORIGIN=https://app.krakovanopas.fi
USER_INVITE_URL_ALLOW_LIST=https://app.krakovanopas.fi/luo-salasana
# Local dev (krk-app Vite on 3000 — avoid 5173/5174; blocked by Windows Hyper-V)
# APP_INVITE_URL=http://localhost:3000/luo-salasana
# APP_ORIGIN=http://localhost:3000
# USER_INVITE_URL_ALLOW_LIST=http://localhost:3000/luo-salasana
KRK_GUIDE_PROVISION_USERS=false