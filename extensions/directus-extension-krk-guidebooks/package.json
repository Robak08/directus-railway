{
	"name": "directus-extension-krk-guidebooks",
	"description": "Guidebook domain schema, access projection, calendar/PDF endpoints, and migration runner",
	"icon": "menu_book",
	"version": "1.0.0",
	"keywords": ["directus", "directus-extension", "directus-custom-bundle", "guidebooks"],
	"license": "UNLICENSED",
	"type": "module",
	"files": ["dist", "README.md"],
	"directus:extension": {
		"type": "bundle",
		"host": "^12.0.0",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "hook",
				"name": "scaffold",
				"source": "src/scaffold-hook/index.ts"
			},
			{
				"type": "hook",
				"name": "validation",
				"source": "src/hooks/validation.ts"
			},
			{
				"type": "endpoint",
				"name": "krk-guidebooks",
				"source": "src/endpoint/index.ts"
			}
		]
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@krk/guidebooks-core": "file:../krk-guidebooks-core"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.1",
		"@types/node": "^22.15.21",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10"
	}
}
