{
	"name": "directus-extension-hook-stripe-raw-body",
	"description": "Capture raw request body for Stripe webhook signature verification",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-hook"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "hook",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^12.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.1",
		"@types/express": "^5.0.3",
		"@types/node": "^22.15.21",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"express": "^4.21.2"
	}
}
