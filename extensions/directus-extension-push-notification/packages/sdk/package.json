{
  "name": "@anthropic/push-notification-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for directus-extension-push-notification — types, API client, and browser subscription helpers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./subscribe": {
      "types": "./dist/subscribe.d.ts",
      "import": "./dist/subscribe.js"
    }
  },
  "files": [
    "dist/**/*",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devix-tecnologia/directus-extension-push-notification.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  }
}
