{
	"name": "krk-stripe",
	"description": "Stripe Checkout session creation for Krakovan Opas app",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-endpoint"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "endpoint",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^12.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.1",
		"@types/node": "^22.15.21",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"stripe": "^18.0.0"
	}
}
